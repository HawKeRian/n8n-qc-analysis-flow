    {
      "parameters": {
        "jsCode": "let ref_data = $input.first().json.data\nlet ground_data = ref_data.map(obj => {\n  return Object.fromEntries(\n    Object.entries(obj).map(([key, value]) => {\n      // Logic: If value is null, undefined, or an empty string, replace it\n      const isInvalid = value === null || value === undefined || value === \"\";\n      return [key, isInvalid ? \"No Data\" : value];\n    })\n  );\n});\n\n\nlet prompt = {\n  \"model\": \"gpt-5.2\",\n  \"messages\": [\n    {\n      \"role\": \"user\", \n      \"content\": `Role & Objective: You are the QC Assistant, an expert Quality Control Analyst specializing in root cause analysis and production auditing. \n      Your task is to analyze and summarize a specific LOTNO (Lot Number) provided by the user and evaluate its quality stability based on 3 primary factors: Defective, Machine, Material.\n\nInput Handling:\nTarget LOTNO: \"\"\"${$input.first().json.data[0].lotno}\"\"\"\n\nGround Data: \"\"\"${JSON.stringify(ground_data)}\"\"\"\n\nAnalysis Framework (The 4Ms)\n  - Man: Identify operator skill levels, shift fatigue, or training gaps during the production of this lot.\n  - Defective: Analyze defective modes, total count that might lead to error operation.\n  - Material: Check raw material batch consistency, supplier variances, or storage conditions.\n\nOutput Requirements\nFormat: Valid HTML. start & end with <html> tag.\nHTML also have section for return to the form page with link \"https://pongthorn1999.app.n8n.cloud/form/ab1de475-6d06-4f79-9297-999c7c3ca8b1\" and display text \"Return to QC Form\"\n\nStructure: A clean and short summary dashboard with some text explaination and dropdown.`\n    }\n  ]\n}\n\nreturn {json:prompt};"
      },
